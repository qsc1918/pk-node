# ---- 运行时数据（含明文 cookie，绝对不要提交）----
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ---- 大体积 / 可重新获取的二进制 ----
# cloudflared 由 bin/get-cloudflared.sh 按需下载，不入库
bin/cloudflared
bin/cloudflared.*

# ---- 依赖 / 构建产物 ----
node_modules/
# tools/make-release.js 的产物
dist/
*.log
# ---- pk.sh / pk.bat 的运行时目录（pid / 端口 / 日志）----
run/

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp
*~
# Worker 部署产物（由 tools/gen-worker-bundle.js 生成，含 2.7MB base64 so）
deploy/w/

# wrangler 本地缓存（含账号 id / 项目状态，不应入库）
deploy/pages/.wrangler/
.wrangler/

# 站点配置文件（部署产物，由 wrangler 上传）
deploy/pages/site.json
